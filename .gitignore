# ==========================================
# UNiOTECH M - Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
frontend_old/node_modules/
backend_s/node_modules/

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example


# Build Outputs & Staging Caches
dist/
dist-ssr/
frontend_old/dist/
frontend_old/dist-ssr/
build/
*/build/
temp_fe_stage/
temp_be_stage/
temp_stage/
.cache/
.parcel-cache/

# Binary & Archive Files
*.zip
*.tar
*.gz
*.rar
*.7z
*.tgz
frontend_old/*.zip
backend_s/*.zip

# Database Files
*.sqlite
*.sqlite3
*.db
dev_database.sqlite
backend_s/dev_database.sqlite
dump.rdb
*.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime Uploads & Temporary Storage
uploads/
*/uploads/
tmp_uploads/
tmp/
temp/

# IDE & OS Files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
desktop.ini
