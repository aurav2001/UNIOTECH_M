# ==============================================================
# UnioTech IT Solutions - Monorepo Environment Variables Reference
# ==============================================================

# ==========================================
# 1. BACKEND CONFIGURATION (backend_s/.env)
# ==========================================
PORT=5000
NODE_ENV=development
USE_CLUSTER=false
RATE_LIMIT_MAX=100
FRONTEND_URL=http://localhost:5173,http://localhost:4173,http://localhost:5174

ADMIN_PASSWORD=change_this_admin_password_123
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
JWT_EXPIRY=24h

# Database: Development uses local SQLite automatically.
# Production uses MySQL:
DB_HOST=localhost
DB_NAME=uniotech_db
DB_USER=root
DB_PASS=your_mysql_password

# Email SMTP Service
EMAIL_HOST=smtp.yourmailserver.com
EMAIL_PORT=465
EMAIL_USER=support@yourdomain.com
EMAIL_PASS=your_email_app_password
EMAIL_RECIPIENT=admin@yourdomain.com

# Cloudinary (Optional - auto falls back to local uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# 2. FRONTEND CONFIGURATION (frontend_old/.env)
# ==========================================
VITE_API_URL=http://localhost:5000
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here
