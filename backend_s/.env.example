# ==============================================================
# UnioTech IT Solutions - Backend Environment Configuration Template
# ==============================================================
# Copy this file to .env and configure with your credentials.

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development
USE_CLUSTER=false
RATE_LIMIT_MAX=100
FRONTEND_URL=http://localhost:5173,http://localhost:4173,http://localhost:5174

# --- SECURITY & AUTHENTICATION ---
# Master admin password for initial admin portal login
ADMIN_PASSWORD=change_this_admin_password_123
# Secret key for signing JWT tokens (min 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
JWT_EXPIRY=24h

# --- DATABASE CONFIGURATION ---
# In development (NODE_ENV=development), the backend automatically uses SQLite (dev_database.sqlite).
# In production (NODE_ENV=production), the backend connects to MySQL using the credentials below:
DB_HOST=localhost
DB_NAME=uniotech_db
DB_USER=root
DB_PASS=your_mysql_password

# --- EMAIL (SMTP) SERVICE ---
# Used for automated ticket alerts, client notifications, and lead forms
EMAIL_HOST=smtp.yourmailserver.com
EMAIL_PORT=465
EMAIL_USER=support@yourdomain.com
EMAIL_PASS=your_email_app_password
EMAIL_RECIPIENT=admin@yourdomain.com

# --- CLOUDINARY CDN CONFIGURATION (OPTIONAL) ---
# Used for cloud image and client document uploads (auto-falls back to local storage if not provided)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- OPTIONAL MONGODB / AUXILIARY ---
MONGODB_URI=
